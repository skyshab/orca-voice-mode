{
  "manifestVersion": 2,
  "id": "voice-mode",
  "name": "Voice Mode",
  "version": "0.2.0",
  "description": "Talk to your Claude agents in Orca: local speech in and out, with a control panel.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "voice-mode",
        "title": "Voice Mode",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
